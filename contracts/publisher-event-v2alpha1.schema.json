{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.local/contracts/publisher-event-v2alpha1.schema.json",
  "title": "SynthRAN paced publisher event v2alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "sensor_id",
    "kind",
    "scheduled_monotonic_s",
    "actual_monotonic_s",
    "lag_ms",
    "qos",
    "success"
  ],
  "properties": {
    "schema": {"const": "synthran/publisher-event/v2alpha1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 63},
    "sensor_id": {"pattern": "^sensor-(0[1-9]|10)$"},
    "kind": {"enum": ["start-canary", "telemetry", "end-canary"]},
    "sequence": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 1}
      ]
    },
    "scheduled_monotonic_s": {"type": "number", "minimum": 0},
    "actual_monotonic_s": {"type": "number", "minimum": 0},
    "lag_ms": {"type": "number"},
    "qos": {"enum": [0, 1]},
    "success": {"type": "boolean"},
    "detail": {"type": "string"}
  }
}

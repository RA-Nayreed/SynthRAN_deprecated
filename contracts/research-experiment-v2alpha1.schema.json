{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.local/contracts/research-experiment-v2alpha1.schema.json",
  "title": "SynthRAN Amber research experiment v2alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "run_id",
    "network_run_id",
    "condition",
    "iot_source",
    "iot_profile",
    "iot_seed",
    "sensor_period_seconds",
    "sensor_count",
    "measurement",
    "load",
    "probe_target",
    "profile_digest",
    "amber_commit",
    "energy_trace_sha256"
  ],
  "properties": {
    "schema": {"const": "synthran/research-experiment/v2alpha1"},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 63},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 63},
    "network_run_id": {"type": "string", "minLength": 1, "maxLength": 63},
    "condition": {"type": "string", "minLength": 1, "maxLength": 33},
    "iot_source": {"const": "amber"},
    "iot_profile": {"enum": ["transport-v1", "ambient-v1"]},
    "iot_seed": {"type": "integer", "minimum": 0},
    "sensor_period_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "sensor_count": {"const": 10},
    "measurement": {"type": "object"},
    "load": {"type": "object"},
    "probe_target": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "profile_digest": {"pattern": "^[0-9a-f]{64}$"},
    "amber_commit": {"pattern": "^[0-9a-f]{40}$"},
    "energy_trace_sha256": {
      "oneOf": [{"type": "null"}, {"pattern": "^[0-9a-f]{64}$"}]
    }
  }
}

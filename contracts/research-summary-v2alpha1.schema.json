{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.local/contracts/research-summary-v2alpha1.schema.json",
  "title": "SynthRAN Amber research summary v2alpha1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "campaign_id",
    "run_id",
    "network_run_id",
    "condition",
    "iot_source",
    "iot_profile",
    "iot_seed",
    "profile_digest",
    "sensor_period_seconds",
    "measurement",
    "source",
    "transport",
    "measurement_received_events",
    "infrastructure_valid",
    "scientific_valid"
  ],
  "properties": {
    "schema": {"const": "synthran/research-summary/v2alpha1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "network_run_id": {"type": "string", "minLength": 1},
    "condition": {"type": "string", "minLength": 1},
    "iot_source": {"const": "amber"},
    "iot_profile": {"enum": ["transport-v1", "ambient-v1"]},
    "iot_seed": {"type": "integer", "minimum": 0},
    "profile_digest": {"pattern": "^[0-9a-f]{64}$"},
    "sensor_period_seconds": {"type": "integer", "minimum": 1},
    "measurement": {"type": "object"},
    "source": {
      "type": "object",
      "required": ["planned_opportunities", "decoded_opportunities", "source_loss"],
      "properties": {
        "planned_opportunities": {"type": "integer", "minimum": 0},
        "decoded_opportunities": {"type": "integer", "minimum": 0},
        "source_loss": {"type": "integer", "minimum": 0}
      }
    },
    "transport": {
      "type": "object",
      "required": ["published_events", "received_events", "transport_loss", "duplicate_count"],
      "properties": {
        "published_events": {"type": "integer", "minimum": 0},
        "received_events": {"type": "integer", "minimum": 0},
        "transport_loss": {"type": "integer", "minimum": 0},
        "duplicate_count": {"type": "integer", "minimum": 0}
      }
    },
    "measurement_received_events": {"type": "integer", "minimum": 0},
    "infrastructure_valid": {"type": "boolean"},
    "scientific_valid": {"type": "boolean"}
  }
}
